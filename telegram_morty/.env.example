# Токены вставлять только в локальный .env, не публиковать.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=openai/gpt-4o-mini
# Для локального запуска через bot_local.py
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:12b
# RAG: chroma (оригинальная база) или local (поиск по knowledge_base.txt)
RAG_BACKEND=chroma
# Ограничения бюджета и нагрузки; хранятся в памяти процесса.
USER_REQUESTS_PER_MINUTE=5
GLOBAL_REQUESTS_PER_MINUTE=40
MAX_DAILY_MODEL_CALLS=150
MAX_CONCURRENT_MODEL_CALLS=2
